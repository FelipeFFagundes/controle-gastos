# Configurações do Aplicativo de Controle de Gastos

# PIN numérico de 6 dígitos para proteção de acesso ao App
APP_PIN=123456

# Chaves da Pluggy (Opcional - caso queira configurar direto nas variáveis)
# PLUGGY_CLIENT_ID=seu_client_id
# PLUGGY_CLIENT_SECRET=seu_client_secret

# Vercel KV / Upstash Redis (Opcional - apenas para persistência em nuvem na Vercel)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
