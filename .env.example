# Copie para .env (local) ou cadastre nas variáveis de ambiente da Vercel.

# PIN numérico de 6 dígitos que protege o app. Em branco = sem proteção.
APP_PIN=123456

# Segredo para assinar os tokens de login. Use um valor aleatório e longo, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Banco de dados
#   Local: deixe em branco para usar o arquivo server/data/gastos.db
#   Vercel: obrigatório. Supabase -> Connect -> Transaction pooler (porta 6543), ex.:
#     postgresql://postgres.abcdefgh:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
#   (também aceita Turso: libsql://... junto com DATABASE_AUTH_TOKEN)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Credenciais da Pluggy (Open Finance). Ficam só no servidor.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Sincronização automática das despesas recentes (últimos 7 dias).
#   Local: de X em X horas enquanto o servidor estiver rodando (0 ou vazio = desligada).
SYNC_INTERVAL_HOURS=0
#   Vercel: o Cron do vercel.json chama /api/cron/sync. Cadastre um valor aleatório aqui;
#   a Vercel o envia automaticamente no cabeçalho Authorization.
CRON_SECRET=
