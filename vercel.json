{
  "version": 2,
  "regions": [
    "pdx1"
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 10 * * *"
    }
  ]
}
